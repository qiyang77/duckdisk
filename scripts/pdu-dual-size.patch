@@ -0,0 +1,59 @@
+#![cfg(target_os = "macos")]
+
+use std::{
+    fs,
+    process::Command,
+    time::{SystemTime, UNIX_EPOCH},
+};
+
+#[test]
+fn counts_pruned_cloud_only_files_without_emitting_per_file_errors() {
+    let nonce = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap()
+        .as_nanos();
+    let root = std::env::temp_dir().join(format!(
+        "duckdisk-cloud-summary-{}-{nonce}",
+        std::process::id()
+    ));
+    let mirror =
+        root.join("Group Containers/UBF8T346G9.OneDriveSyncClientSuite/OneDrive.noindex/OneDrive");
+    fs::create_dir_all(&mirror).unwrap();
+    let remote_only = mirror.join("remote-only.bin");
+    let file = fs::OpenOptions::new()
+        .create_new(true)
+        .write(true)
+        .open(&remote_only)
+        .unwrap();
+    file.set_len(64 * 1024 * 1024).unwrap();
+    let output = Command::new(env!("CARGO_BIN_EXE_pdu"))
+        .args([
+            "--json-output",
+            "--quantity=dual-size",
+            "--threads=max",
+            "--max-depth=1",
+            "--min-ratio=0",
+        ])
+        .arg(&root)
+        .output()
+        .unwrap();
+    fs::remove_dir_all(&root).unwrap();
+    assert!(
+        output.status.success(),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert!(!String::from_utf8_lossy(&output.stderr).contains("cloud placeholder skipped"));
+    let parsed: serde_json::Value = serde_json::from_slice(&output.stdout).unwrap();
+    assert_eq!(parsed["tree"]["cloudSkippedFiles"], 1);
+    assert_eq!(parsed["tree"]["totalFiles"], 1);
+    assert!(parsed["tree"]["totalFolders"].as_u64().unwrap_or_default() >= 5);
+    assert_eq!(
+        parsed["tree"]["cloudSkippedFolders"]
+            .as_u64()
+            .unwrap_or_default(),
+        0
+    );
+    assert_eq!(parsed["tree"]["children"].as_array().unwrap().len(), 0);
+    assert!(parsed["tree"]["size"]["apparent"].as_u64().unwrap() < 1024);
+}
