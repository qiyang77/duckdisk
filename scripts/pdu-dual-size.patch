+/// Returns both apparent and allocated byte counts from one metadata lookup.
+#[cfg(unix)]
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct GetDualSize;
+
+/// OneDrive's private sync mirror can hold remote-only files with a logical
+/// length but no allocated blocks and without SF_DATALESS. This is narrower
+/// than treating every zero-block sparse file as a cloud placeholder.
+#[cfg(target_os = "macos")]
+pub(crate) fn is_onedrive_remote_placeholder(metadata: &Metadata, path: &Path) -> bool {
+    use std::ffi::OsStr;
+    metadata.is_file()
+        && metadata.blocks() == 0
+        && metadata.len() > 0
+        // Only the observed private cache layout is eligible. Merely having
+        // both names anywhere in a path could hide a user's ordinary sparse file.
+        && path
+            .components()
+            .map(|component| component.as_os_str())
+            .collect::<Vec<_>>()
+            .windows(4)
+            .any(|part| {
+                part == [
+                    OsStr::new("Group Containers"),
+                    OsStr::new("UBF8T346G9.OneDriveSyncClientSuite"),
+                    OsStr::new("OneDrive.noindex"),
+                    OsStr::new("OneDrive"),
+                ]
+            })
+}
+
+#[cfg(unix)]
+impl GetSize for GetDualSize {
+    type Size = DualBytes;
+
+    #[inline]
+    fn get_size(&self, metadata: &Metadata, path: &Path) -> Self::Size {
+        let allocated = metadata.blocks() * 512;
+        #[cfg(target_os = "macos")]
+        const SF_DATALESS: u32 = 0x4000_0000;
+        #[cfg(target_os = "macos")]
+        let apparent = if metadata.st_flags() & SF_DATALESS != 0
+            || is_onedrive_remote_placeholder(metadata, path)
+        {
+            0
+        } else {
+            metadata.len()
+        };
+        #[cfg(not(target_os = "macos"))]
+        let apparent = metadata.len();
+
+        DualBytes {
+            allocated,
+            apparent,
+        }
+    }
+}
+
+#[cfg(all(test, target_os = "macos"))]
+mod duckdisk_size_tests {
+    use super::{GetDualSize, GetSize};
+    #[test]
+    fn keeps_logical_size_of_ordinary_zero_block_sparse_file() {
+        let path =
+            std::env::temp_dir().join(format!("duckdisk-sparse-test-{}", std::process::id()));
+        let file = std::fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&path)
+            .unwrap();
+        file.set_len(64 * 1024 * 1024).unwrap();
+        let metadata = file.metadata().unwrap();
+        let size = GetDualSize.get_size(&metadata, &path);
+        std::fs::remove_file(path).unwrap();
+        assert_eq!(size.apparent, 64 * 1024 * 1024);
+        assert_eq!(size.allocated, 0);
+    }
+
+    #[test]
+    fn excludes_remote_only_onedrive_mirror_without_hiding_other_sparse_files() {
+        let base = std::env::temp_dir().join(format!(
+            "duckdisk-onedrive-size-test-{}",
+            std::process::id()
+        ));
+        let mirror = base
+            .join("Group Containers/UBF8T346G9.OneDriveSyncClientSuite/OneDrive.noindex/OneDrive");
+        std::fs::create_dir_all(&mirror).unwrap();
+        let path = mirror.join("remote-only.bin");
+        let file = std::fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&path)
+            .unwrap();
+        file.set_len(64 * 1024 * 1024).unwrap();
+        let metadata = file.metadata().unwrap();
+        let size = GetDualSize.get_size(&metadata, &path);
+        assert_eq!((size.apparent, size.allocated), (0, 0));
+        std::fs::remove_file(path).unwrap();
+        std::fs::remove_dir_all(base).unwrap();
+    }
+
+    #[test]
+    fn onedrive_name_fragments_elsewhere_do_not_hide_sparse_files() {
+        let base = std::env::temp_dir().join(format!(
+            "duckdisk-onedrive-path-test-{}",
+            std::process::id()
+        ));
+        let unrelated = base.join("Group Containers/UBF8T346G9.OneDriveSyncClientSuite/unrelated/OneDrive.noindex/OneDrive");
