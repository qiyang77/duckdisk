index 334ce48..b6f7379 100644
--- a/cli/main.rs
+++ b/cli/main.rs
@@ -3,0 +4,5 @@ fn main() -> ExitCode {
+    #[cfg(target_os = "macos")]
+    if let Err(error) = disable_cloud_materialization() {
+        eprintln!("Cannot safely scan without disabling automatic cloud downloads: {error}");
+        return ExitCode::FAILURE;
+    }
@@ -5,0 +11,53 @@ fn main() -> ExitCode {
+
+#[cfg(target_os = "macos")]
+fn disable_cloud_materialization() -> std::io::Result<()> {
+    // Public Darwin constants from sys/resource.h. Set this before Rayon workers
+    // or path metadata lookups, including lookups through dataless ancestors.
+    const IOPOL_TYPE_VFS_MATERIALIZE_DATALESS_FILES: i32 = 3;
+    const IOPOL_SCOPE_PROCESS: i32 = 0;
+    const IOPOL_MATERIALIZE_DATALESS_FILES_OFF: i32 = 1;
+    unsafe extern "C" {
+        fn setiopolicy_np(iotype: i32, scope: i32, policy: i32) -> i32;
+        fn getiopolicy_np(iotype: i32, scope: i32) -> i32;
+    }
+    let result = unsafe {
+        setiopolicy_np(
+            IOPOL_TYPE_VFS_MATERIALIZE_DATALESS_FILES,
+            IOPOL_SCOPE_PROCESS,
+            IOPOL_MATERIALIZE_DATALESS_FILES_OFF,
+        )
+    };
+    if result != 0 {
+        return Err(std::io::Error::last_os_error());
+    }
+    let active = unsafe {
+        getiopolicy_np(
+            IOPOL_TYPE_VFS_MATERIALIZE_DATALESS_FILES,
+            IOPOL_SCOPE_PROCESS,
+        )
+    };
+    if active != IOPOL_MATERIALIZE_DATALESS_FILES_OFF {
+        return Err(std::io::Error::other(
+            "macOS did not apply the no-download policy",
+        ));
+    }
+    Ok(())
+}
+
+#[cfg(all(test, target_os = "macos"))]
+mod tests {
+    #[test]
+    fn applies_no_download_policy_before_scanning() {
+        super::disable_cloud_materialization().unwrap();
+        std::thread::spawn(|| {
+            unsafe extern "C" {
+                fn getiopolicy_np(iotype: i32, scope: i32) -> i32;
+            }
+            assert_eq!(unsafe { getiopolicy_np(3, 0) }, 1);
+            // New workers use the process policy rather than overriding it.
+            assert_eq!(unsafe { getiopolicy_np(3, 1) }, 0);
+        })
+        .join()
+        .unwrap();
+    }
+}
