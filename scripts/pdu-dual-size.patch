diff --git a/src/size.rs b/src/size.rs
index 34224b8..89f9a73 100644
--- a/src/size.rs
+++ b/src/size.rs
@@ -129,0 +130,82 @@ newtype!(
+
+/// Apparent and allocated byte counts collected from one metadata lookup.
+///
+/// Ordering and scalar conversion intentionally use allocated bytes so pdu's
+/// sorting, progress, and minimum-ratio behavior continue to describe physical
+/// disk usage.
+#[cfg(unix)]
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+#[derive(Add, AddAssign, Sub, SubAssign, Sum)]
+#[cfg_attr(feature = "json", derive(Deserialize, Serialize))]
+pub struct DualBytes {
+    pub allocated: u64,
+    pub apparent: u64,
+}
+
+#[cfg(unix)]
+impl From<u64> for DualBytes {
+    fn from(value: u64) -> Self {
+        Self {
+            allocated: value,
+            apparent: value,
+        }
+    }
+}
+
+#[cfg(unix)]
+impl From<DualBytes> for u64 {
+    fn from(value: DualBytes) -> Self {
+        value.allocated
+    }
+}
+
+#[cfg(unix)]
+impl Mul<DualBytes> for DualBytes {
+    type Output = Self;
+
+    fn mul(self, rhs: DualBytes) -> Self::Output {
+        Self {
+            allocated: self.allocated * rhs.allocated,
+            apparent: self.apparent * rhs.apparent,
+        }
+    }
+}
+
+#[cfg(unix)]
+macro_rules! impl_dual_mul {
+    ($($num_type:ident)+) => {
+        $(
+            impl Mul<$num_type> for DualBytes {
+                type Output = Self;
+
+                fn mul(self, rhs: $num_type) -> Self::Output {
+                    Self {
+                        allocated: self.allocated * rhs as u64,
+                        apparent: self.apparent * rhs as u64,
+                    }
+                }
+            }
+
+            impl MulAssign<$num_type> for DualBytes {
+                fn mul_assign(&mut self, rhs: $num_type) {
+                    self.allocated *= rhs as u64;
+                    self.apparent *= rhs as u64;
+                }
+            }
+        )+
+    };
+}
+
+#[cfg(unix)]
+impl_dual_mul!(usize u8 u16 u32 u64);
+
+#[cfg(unix)]
+impl Size for DualBytes {
+    type Inner = Self;
+    type DisplayFormat = BytesFormat;
+    type DisplayOutput = bytes_format::Output;
+
+    fn display(self, format: Self::DisplayFormat) -> Self::DisplayOutput {
+        format.format(self.allocated)
+    }
+}
