@@ -7,0 +8,2 @@ use std::os::unix::prelude::MetadataExt;
+#[cfg(target_os = "macos")]
+use std::os::macos::fs::MetadataExt as MacMetadataExt;
@@ -38,0 +41,31 @@ impl GetSize for GetBlockSize {
+/// Returns both apparent and allocated byte counts from one metadata lookup.
+#[cfg(unix)]
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct GetDualSize;
+#[cfg(unix)]
+impl GetSize for GetDualSize {
+    type Size = DualBytes;
+
+    #[inline]
+    fn get_size(&self, metadata: &Metadata) -> Self::Size {
+        let allocated = metadata.blocks() * 512;
+        #[cfg(target_os = "macos")]
+        const UF_DATALESS: u32 = 0x4000_0000;
+        #[cfg(target_os = "macos")]
+        let apparent = if metadata.st_flags() & UF_DATALESS != 0
+            || (allocated == 0 && metadata.len() > 0)
+        {
+            0
+        } else {
+            metadata.len()
+        };
+        #[cfg(not(target_os = "macos"))]
+        let apparent = metadata.len();
+
+        DualBytes {
+            allocated,
+            apparent,
+        }
+    }
+}
+
